# 복사해서 .env.local 로 쓰세요. 실제 값은 절대 커밋하지 않습니다.
# 로컬 개발은 dev Supabase 프로젝트 값을 넣습니다 (prod 값 금지).

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
SUPABASE_SECRET_KEY=

# npm run seed:admin 에서만 사용
ADMIN_INITIAL_PASSWORD=

# 관련 뉴스 (선택) — https://developers.naver.com 에서 검색 API 키 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# SOS (B) — 서버 전용. 공공데이터포털 일반 인증키(Decoding), Google AI Studio 키
DATA_GO_KR_SERVICE_KEY=
# Gemini 키는 결제 계정이 연결되지 않은 Google AI Studio 프로젝트에서 만든다 (무료 등급만 사용).
GEMINI_API_KEY=

# 영업기회 AI 코칭 (A, 선택) — 서버 전용. 비워 두면 규칙 기반 코칭만 쓴다
# 모델에는 회사·사람 이름과 메모 본문 없이 익명 신호만 보낸다 (src/features/deals/coach/signals.ts)
#   openai: OpenAI 호환 API (사내 sLLM: vLLM·Ollama·LM Studio 등). 주소는 https 만
#   gemini: 위 GEMINI_API_KEY 를 함께 쓴다
AI_COACH_PROVIDER=
AI_COACH_BASE_URL=
AI_COACH_MODEL=
AI_COACH_API_KEY=
